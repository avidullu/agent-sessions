.venv/
.venv-local-ci/
__pycache__/
.pytest_cache/
.coverage
*.egg-info/
build/
dist/
work/
tmp/

# Raw transcripts can be very large and may include secrets or full tool output.
# Use `git add -f raw/` only when you intentionally want raw backups in GitHub.
raw/

# Rendered transcript artifacts are local-only by default. Keep the catalog in
# Git, but do not commit full Markdown/PDF transcript bodies unless an explicit
# repo migration chooses `[archive] track_artifacts = true`.
archive/**/*.md
archive/**/*.pdf
!archive/INDEX.md

# Local diagnostics/state written by the VS Code feeder extension.
archive/.router/

# Optional primary-host marker written by scripts/local-export.sh --write-primary-marker.
archive/.primary-host

# Per-machine discovery inventory (regenerated by `agent-archive discover --write`).
docs/DISCOVERY.md

# Local machine overrides.
sources.toml

# Concurrent export lock files.
.daily-export.lock
.local-export.lock

# Agent evidence bundles can contain raw excerpts from private/client code or sessions.
baseline/evidence/*.json
baseline/evidence/*.prompt.md

# Replay bundles can contain full prompts/deliverables even after redaction review.
baseline/replay/bundles/

# wrangler local state (site/ deploys)
site/.wrangler/
