#!/usr/bin/env bash
set -euo pipefail

# Git pre-push hook: run scripts/local_ci.sh before the push leaves the machine.
#
# This hook is opt-in and never installs itself. Install it explicitly, once per
# clone (git does not track .git/hooks):
#
#     ln -s ../../scripts/pre-push .git/hooks/pre-push   # see docs/LOCAL_CI.md
#
# It never writes to tracked files, the index, the working tree, or git config.
# It does create a temporary detached worktree (removed on exit) when the
# checkout does not match the pushed commit, and the gate script it runs writes
# gitignored build artifacts (`*.egg-info/`, `.coverage`).
#
# Bypasses, in increasing order of "I know what I am doing":
#   1. docs-only push          — skipped automatically (see below)
#   2. SKIP_LOCAL_CI=1 git push — skip the gates for one push
#   3. git push --no-verify     — skip every hook entirely
#
# See docs/LOCAL_CI.md.

# Documentation files that no gate reads. Deliberately a positive allowlist:
# anything unrecognised runs the gates, so a new file type can never silently
# turn the hook off. `.txt` is NOT here — constraints-dev.txt is gate input, and
# a `docs/**` catch-all is not here either, since it would classify a .py file
# under a docs/ directory as documentation.
#
# Safe in this repo specifically because CI has no docs gate (no link check, no
# markdown lint) and no test reads a tracked .md file. Revisit if that changes.
is_docs_only() {
  local file any=0
  while IFS= read -r file || [[ -n "$file" ]]; do
    # git feeds LF, but Windows callers (Git Bash pipelines, Python text-mode
    # subprocess in the tests) feed CRLF; a trailing CR must not defeat the
    # allowlist match below.
    file="${file%$'\r'}"
    if [[ -z "${file//[[:space:]]/}" ]]; then
      continue
    fi
    any=1
    case "$file" in
      *.md|*.markdown|*.rst) ;;
      LICENSE|LICENSE.*|COPYING|NOTICE) ;;
      *) return 1 ;;
    esac
  done
  # No files at all => not provably docs-only => run the gates.
  [[ "$any" -eq 1 ]]
}

# Test seam: `printf '%s\n' a b | LOCAL_CI_CHECK_FILES=1 scripts/pre-push` prints
# run|skip. An env var, not a flag, because git already owns $1/$2 here
# (<remote-name> <remote-url>).
if [[ "${LOCAL_CI_CHECK_FILES:-}" == "1" ]]; then
  if is_docs_only; then echo "skip"; else echo "run"; fi
  exit 0
fi

if [[ "${SKIP_LOCAL_CI:-}" == "1" ]]; then
  echo "pre-push: SKIP_LOCAL_CI=1 — skipping local CI gates."
  exit 0
fi

# Resolve the repo, not the hook's location: the hook may run from .git/hooks or
# from core.hooksPath, and git runs hooks with cwd at the top level anyway.
repo_root="$(git rev-parse --show-toplevel)"
cd "$repo_root"

gate="$repo_root/scripts/local_ci.sh"
if [[ ! -f "$gate" ]]; then
  echo "pre-push: $gate not found — refusing to claim the push was gated." >&2
  exit 1
fi

remote="${1:-origin}"
zero="$(git hash-object --stdin </dev/null | tr '[:alnum:]' '0')"

# git feeds the hook `<local ref> <local sha> <remote ref> <remote sha>` on
# stdin, one line per pushed ref. (`git diff --cached` is wrong here: nothing is
# staged at push time.)
#
# Everything here fails CLOSED. A range we cannot compute means "we do not know
# what is being pushed", which must run the gates — the opposite of the earlier
# `|| true`, which turned an unresolvable range (any force-push after the remote
# moved, so the remote sha is absent locally) into "zero files changed" and let a
# docs-only sibling ref classify the whole push as documentation.
changed=""
push_shas=()
force_gate=0
pushed_any=0
while read -r _local_ref local_sha _remote_ref remote_sha; do
  remote_sha="${remote_sha%$'\r'}"  # tolerate CRLF stdin (see is_docs_only)
  if [[ -z "${local_sha:-}" || "$local_sha" == "$zero" ]]; then
    continue  # branch deletion
  fi
  pushed_any=1
  push_shas+=("$local_sha")
  if [[ "$remote_sha" == "$zero" ]]; then
    # New branch: diff against the oldest commit the remote does not have yet.
    # Derived from the remote's own refs rather than a hardcoded origin/main,
    # because this repo's primary remote is Forgejo (`forge`).
    if ! oldest="$(git rev-list "$local_sha" --not --remotes="$remote" 2>/dev/null | tail -n 1)"; then
      force_gate=1
      continue
    fi
    if [[ -z "$oldest" ]]; then
      continue  # the remote already has every one of these commits
    fi
    if ! base="$(git rev-parse --verify --quiet "${oldest}^" 2>/dev/null)"; then
      # Pushing a root commit: no base to diff against, so gate it.
      force_gate=1
      continue
    fi
    range="${base}..${local_sha}"
  else
    if ! git cat-file -e "${remote_sha}^{commit}" 2>/dev/null; then
      # The remote sha is not in this clone (someone else moved the branch, or a
      # force-push over a rewritten history). We cannot tell what is new.
      echo "pre-push: cannot resolve remote commit $remote_sha — gating." >&2
      force_gate=1
      continue
    fi
    range="${remote_sha}..${local_sha}"
  fi
  if ! files="$(git diff --name-only "$range" 2>/dev/null)"; then
    echo "pre-push: cannot diff $range — gating." >&2
    force_gate=1
    continue
  fi
  changed+=$'\n'"$files"
done

if [[ "$pushed_any" -eq 0 ]]; then
  echo "pre-push: nothing to gate (branch deletion or no new commits)."
  exit 0
fi

if [[ "$force_gate" -eq 0 ]] &&
  [[ -n "${changed//[[:space:]]/}" ]] &&
  printf '%s\n' "$changed" | is_docs_only; then
  echo "pre-push: documentation-only push — skipping local CI gates."
  echo "pre-push: run scripts/local_ci.sh manually if you want the full verdict."
  exit 0
fi

echo "pre-push: running local CI gates (SKIP_LOCAL_CI=1 or --no-verify to bypass)."

# ── Gate the pushed COMMITS, not the checkout ───────────────────────
#
# git pushes commits; the working tree may be ahead of, behind, or unrelated to
# them (`git push origin feat:feat` from another branch, or uncommitted edits
# that hide a broken commit). Gating the checkout produced both a false green — a
# red commit reaching the remote under an "all gates passed" verdict — and a
# false red, where unrelated dirty files blocked a clean push. So: use the
# checkout only when it provably equals the pushed commit, otherwise gate a
# throwaway detached worktree at that exact sha.

worktree_dir=""
cleanup_worktree() {
  if [[ -n "$worktree_dir" ]]; then
    git worktree remove --force "$worktree_dir" >/dev/null 2>&1 || rm -rf "$worktree_dir"
    worktree_dir=""
  fi
}
trap cleanup_worktree EXIT

head_sha="$(git rev-parse --verify --quiet HEAD 2>/dev/null || true)"
tree_clean=0
if [[ -z "$(git status --porcelain 2>/dev/null)" ]]; then
  tree_clean=1
fi

gate_sha() {
  local sha="$1" status=0
  if [[ "$tree_clean" -eq 1 && -n "$head_sha" && "$head_sha" == "$sha" ]]; then
    echo "pre-push: gating ${sha:0:12} (clean checkout is that commit)."
    bash "$gate" || status=$?
    return "$status"
  fi

  echo "pre-push: gating ${sha:0:12} in a temporary worktree (the checkout is not that commit)."
  worktree_dir="$(mktemp -d -t agent-sessions-prepush-XXXXXX)"
  rmdir "$worktree_dir"
  if ! git worktree add --detach --quiet "$worktree_dir" "$sha" 2>&1; then
    worktree_dir=""
    echo "pre-push: could not create a worktree for $sha — refusing to claim the push was gated." >&2
    return 1
  fi
  local wt_gate="$worktree_dir/scripts/local_ci.sh"
  if [[ ! -f "$wt_gate" ]]; then
    echo "pre-push: $sha does not contain scripts/local_ci.sh — cannot gate it." >&2
    echo "pre-push: use 'git push --no-verify' if you really mean to push this history." >&2
    cleanup_worktree
    return 1
  fi
  # Run it from inside the worktree so anything the gate resolves relative to
  # its cwd sees the pushed commit, not the checkout.
  (cd "$worktree_dir" && bash scripts/local_ci.sh) || status=$?
  cleanup_worktree
  return "$status"
}

# De-duplicate: pushing the same sha under two refs is one thing to gate.
seen=""
overall=0
for sha in "${push_shas[@]}"; do
  case "$seen" in
    *"|$sha|"*) continue ;;
  esac
  seen+="|$sha|"
  gate_sha "$sha" || overall=$?
done

exit "$overall"
